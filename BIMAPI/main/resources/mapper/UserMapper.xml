<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunfan.tmcc.ivr.dao.UserMapper">
	<resultMap id="UserMap" type="java.util.HashMap">
		<result column="user_id" property="userId" jdbcType="INTEGER" />
		<result column="user_name" property="userName" jdbcType="VARCHAR" />
		<result column="user_real_name" property="userRealName" jdbcType="VARCHAR" />
		<result column="password" property="password" jdbcType="VARCHAR" />
		<result column="last_ip" property="lastIp" jdbcType="VARCHAR" />
		<result column="last_visit" property="lastVisit" jdbcType="TIMESTAMP" />
	</resultMap>

	<!-- 根据主键查询用户 -->
	<select id="selectUserById" resultMap="UserMap" resultType="java.util.List" parameterType="long">
		SELECT t.user_id, t.user_name, t.password , t.last_ip, t.last_visit
		FROM t_user t where t.user_id = #{userId}
	</select>

	<!-- 根据主键查询用户 -->
	<select id="selectUserByName" resultMap="UserMap" resultType="java.util.List" parameterType="String">
		SELECT t.user_id, t.user_name, t.password , t.last_ip, t.last_visit
		FROM t_user t where t.user_name = #{userName}
	</select>

	<!-- 插入数据 -->
	<insert id="insertUser" useGeneratedKeys="true" keyProperty="user_id"	parameterType="java.util.Map">
		insert into t_user(user_name, password, last_ip,last_visit)
		values(#{userName},#{password}, #{lastIp}, #{lastVisit})
	</insert>

</mapper>