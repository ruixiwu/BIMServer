<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yunfan.tmcc.ivr.dao.GeoBlockMapper">
	<resultMap id="GeoBlockMap" type="java.util.HashMap">
		<id column="OBJECTID" property="OBJECTID" jdbcType="INTEGER" />
		<result column="NAME" property="NAME" jdbcType="VARCHAR" />
		<result column="DESCRIBE" property="DESCRIBE" jdbcType="VARCHAR" />
		<result column="MESHIDS" property="MESHIDS" jdbcType="VARCHAR" />
	</resultMap>

	<!-- 根据主键查询用户 -->
	<select id="selectGeoBlockById" resultMap="GeoBlockMap" parameterType="java.util.Map">
		SELECT t.NAME, t.DESCRIBE , t.MESHIDS FROM  ${TABLENAME} t where t.OBJECTID = #{OBJECTID}
	</select>
	<!-- 插入数据 -->
	<insert id="insertGeoBlock" useGeneratedKeys="true" keyProperty="OBJECTID"
		parameterType="java.util.Map">
		insert into  ${TABLENAME} (NAME, DESCRIBE,MESHIDS) values(#{NAME}, #{DESCRIBE}, #{MESHIDS})
	</insert>
	
	<update id="createTable" parameterType="String">
		CREATE TABLE ${_parameter} (
    	OBJECTID int IDENTITY(1,1)  NOT NULL,
    	NAME varchar(128) DEFAULT NULL,
    	DESCRIBE varchar(128) DEFAULT NULL,
    	MESHIDS varchar(256) DEFAULT NULL,
    PRIMARY KEY (OBJECTID)
    ) 
    </update>
    
    <insert id="insertBatch" parameterType="java.util.List">
	    insert into ${TABLENAME} (NAME, DESCRIBE,MESHIDS) 
	    values 
	    <foreach collection="list" item="item" index="index" separator="," >
	        (#{item.NAME}, #{item.DESCRIBE},#{item.MESHIDS})
	    </foreach>
	</insert>
</mapper>